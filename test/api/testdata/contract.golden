# The API contract, as field-path shapes. Written by TestAPIContract.
# Regenerate after an intended change: go test ./test/api -run TestAPIContract -update

GET /api/health -> 200
  database: string
  ok: bool
  serverTime: number

POST /api/admin/login -> 200
  name: string
  token: string
  username: string

GET /api/admin/me -> 200
  demoMode: bool
  name: string
  role: string
  username: string

GET /api/admin/recap/summary -> 200
  last7.revenue: number
  last7.sales: number
  month.revenue: number
  month.sales: number
