  totals.reported: number
  totals.revenue: number
  totals.sales: number

GET /api/admin/transactions -> 200
  dispensedCount: number
  dispensedRevenue: number
  page: number
  pageSize: number
  rows[].createdAt: number
  rows[].customerReportedAt: null
  rows[].failureReason: null|string
  rows[].finishedAt: number
  rows[].id: string
  rows[].machine.code: string
  rows[].machine.id: number
  rows[].machine.name: string
  rows[].paidAt: number
  rows[].price: number
  rows[].product.id: number
  rows[].product.name: string
  rows[].slotNumber: number
  rows[].status: string
  total: number

GET /api/admin/restock-sessions -> 200
  page: number
  pageSize: number
  rows[].clientId: string
  rows[].finishedAt: number
  rows[].id: number
  rows[].itemsAdded: number
  rows[].items[].productChanged: bool
  rows[].items[].productId: number
  rows[].items[].productName: string
  rows[].items[].qtyAfter: number
  rows[].items[].qtyBefore: number
  rows[].items[].slotNumber: number
  rows[].machine.code: string
  rows[].machine.id: number
  rows[].machine.name: string
  rows[].note: null
  rows[].operator.id: number
  rows[].operator.name: string
  rows[].operator.username: string
  rows[].slotsChanged: number
  rows[].startedAt: number
  total: number

GET /api/admin/products -> 200
  [].createdAt: number
