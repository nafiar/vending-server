GET /api/nope -> 404 NOT_FOUND
  code: string
  message: string

DELETE /api/admin/products -> 404 NOT_FOUND
  code: string
  message: string

GET /api/admin/me (no token) -> 401 UNAUTHORIZED
  code: string
  message: string

POST /api/admin/login (wrong password) -> 401 INVALID_LOGIN
  attemptsLeft: number
  code: string
  message: string

POST /api/admin/login (operator account) -> 403 FORBIDDEN
  code: string
  message: string

GET /api/machine/catalog (bad key) -> 401 INVALID_MACHINE_KEY
  code: string
  message: string

GET /api/machine/operator/slots (no operator token) -> 401 UNAUTHORIZED
  code: string
  message: string

POST /api/admin/products (empty) -> 422 VALIDATION
  code: string
  fields.name: string
  fields.price: string
  message: string

POST /api/admin/products (bad json) -> 400 BAD_REQUEST
  code: string
  message: string

GET /api/admin/machines/{id} (unknown) -> 404 NOT_FOUND
  code: string
  message: string

PUT /api/admin/products/{id} (unknown) -> 404 NOT_FOUND
  code: string
  message: string

POST /api/machine/transactions/{id}/pay (unknown) -> 404 NOT_FOUND
  code: string
  message: string

POST /api/machine/transactions (bad uuid) -> 422 INVALID_INPUT
  code: string
  fields.id: string
  message: string

POST /api/machine/transactions (stale catalog) -> 409 CATALOG_STALE
  catalog.catalogVersion: number
  catalog.machine.code: string
  catalog.machine.name: string
  catalog.slots[].available: bool
  catalog.slots[].product.description: string
  catalog.slots[].product.id: number
  catalog.slots[].product.imageUrl: string
  catalog.slots[].product.name: string
  catalog.slots[].product.price: number
  catalog.slots[].slotNumber: number
  code: string
  message: string

POST /api/machine/transactions (sold out) -> 409 SOLD_OUT
  code: string
  message: string

POST /api/machine/transactions/{id}/result (not paid) -> 409 NOT_PAID
  code: string
  message: string

POST /api/machine/transactions/{id}/report (not reportable) -> 409 NOT_REPORTABLE
  code: string
  message: string

POST /api/machine/transactions/{id}/result (bad status) -> 422 INVALID_INPUT
  code: string
  fields.status: string
  message: string

POST /api/machine/transactions/{id}/pay (cancelled) -> 409 TRANSACTION_CLOSED
  code: string
  message: string

POST /api/machine/transactions/{id}/result (already recorded) -> 409 CONFLICT
  code: string
  current.customerReportedAt: number
  current.failureReason: null
  current.finishedAt: number
  current.id: string
  current.paidAt: number
  current.status: string
  message: string

POST /api/machine/transactions (too large) -> 413 PAYLOAD_TOO_LARGE
  code: string
  message: string

POST /api/machine/operator/login (locked) -> 423 LOCKED
  code: string
  message: string
  retryInSeconds: number

POST /api/machine/transactions/{id}/pay (expired) -> 410 EXPIRED
  code: string
  message: string

POST /api/machine/transactions/{id}/report (window closed) -> 409 REPORT_WINDOW_CLOSED
  code: string
  message: string

POST /api/admin/demo/reset -> 200
  ok: bool

GET /api/admin/me (after reset) -> 401 UNAUTHORIZED
  code: string
  message: string
