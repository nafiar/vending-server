# Copy to .env and adjust. Real environment variables win over this file.

# MySQL 8.0 or newer. The database is created on first start if the user may create it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vending
# Or one DSN instead of the five lines above:
# DB_DSN=vending:secret@tcp(127.0.0.1:3306)/vending

# Where the server listens. The admin web is at http://localhost:8080/
HTTP_ADDR=:8080
# HTTPS (NFR-04) when the server faces the internet; leave empty behind a TLS proxy or on localhost.
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Calendar days, hours and "today" in the recap. Use a zone without daylight saving time.
TIMEZONE=Asia/Jakarta

# Product images are written here and served under /uploads/.
UPLOAD_DIR=data/uploads

# Apply pending schema migrations at start-up.
AUTO_MIGRATE=true

# Business-rule timers (BR-06, BR-13).
ADMIN_SESSION_IDLE=30m
OPERATOR_SESSION_IDLE=2m
PAYMENT_WINDOW=60s

# text or json; debug, info, warn or error
LOG_FORMAT=text
LOG_LEVEL=info
